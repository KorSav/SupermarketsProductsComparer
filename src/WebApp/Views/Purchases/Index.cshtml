@using ApplicationCore.Entities.Request
@using WebApp.Mappings
@model WebApp.Models.PurchasesViewModel

@{
    ViewData["Title"] = "Покупки";

    int currentPage = Model.Query.Page;
    int previousPage = currentPage - 1;
    int nextPage = currentPage + 1;

    string FormatDateInput(DateOnly? date)
    {
        return date?.ToString("yyyy-MM-dd") ?? "";
    }

    string FormatMoney(decimal value)
    {
        return value.ToString("0.00");
    }

    string FormatItemsCount(int count)
    {
        int lastTwoDigits = count % 100;
        int lastDigit = count % 10;

        if (lastTwoDigits is >= 11 and <= 14)
        {
            return $"{count} товарів";
        }

        return lastDigit switch
        {
            1 => $"{count} товар",
            >= 2 and <= 4 => $"{count} товари",
            _ => $"{count} товарів"
        };
    }

    string GetSortByLabel(PurchaseSortBy value)
    {
        return value.ToString() switch
        {
            "Date" => "Датою",
            "Price" => "Сумою",
            _ => value.ToString()
        };
    }

    string GetSortOrderLabel(SortOrder value)
    {
        return value.ToString() switch
        {
            "Asc" => "За зростанням",
            "Desc" => "За спаданням",
            _ => value.ToString()
        };
    }
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Покупки</h1>
        <p class="text-muted mb-0">
            Збережені чеки зі списків продуктів.
        </p>
    </div>

    <div class="text-md-end">
        <div class="text-muted small">Знайдено покупок</div>
        <div class="h4 mb-0">@Model.TotalCount</div>

        @if (!Model.IsEmpty)
        {
            <button id="toggleAllReceiptsBtn" type="button" class="btn btn-outline-primary btn-sm mt-2"
                    data-expanded="false">
                <i class="bi bi-list-ul"></i>
                Показати всі чеки
            </button>
        }
    </div>
</div>

@Html.AntiForgeryToken()

<div id="purchasesAlert" class="alert d-none" role="alert"></div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white">
        <div class="fw-semibold">
            <i class="bi bi-funnel"></i>
            Фільтри та сортування
        </div>
    </div>

    <div class="card-body">
        <form asp-controller="Purchases" asp-action="Index" method="get" class="row g-3">
            <div class="col-12 col-md-3">
                <label class="form-label" for="dateFrom">Дата від</label>
                <input id="dateFrom" name="DateFrom" type="date" class="form-control"
                       value="@FormatDateInput(Model.Query.DateFrom)" />
            </div>

            <div class="col-12 col-md-3">
                <label class="form-label" for="dateTo">Дата до</label>
                <input id="dateTo" name="DateTo" type="date" class="form-control"
                       value="@FormatDateInput(Model.Query.DateTo)" />
            </div>

            <div class="col-12 col-md-3">
                <label class="form-label" for="minTotal">Мінімальна сума</label>
                <input id="minTotal" name="MinTotal" type="number" step="0.01" min="0" class="form-control"
                       value="@Model.Query.MinTotal?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" />
            </div>

            <div class="col-12 col-md-3">
                <label class="form-label" for="maxTotal">Максимальна сума</label>
                <input id="maxTotal" name="MaxTotal" type="number" step="0.01" min="0" class="form-control"
                       value="@Model.Query.MaxTotal?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" />
            </div>

            <div class="col-12 col-md-3">
                <label class="form-label" for="sortBy">Сортувати за</label>
                <select id="sortBy" name="SortBy" class="form-select">
                    @foreach (PurchaseSortBy sortBy in Enum.GetValues<PurchaseSortBy>())
                    {
                        if (Model.Query.SortBy == sortBy)
                        {
                            <option value="@sortBy" selected>@GetSortByLabel(sortBy)</option>
                        }
                        else
                        {
                            <option value="@sortBy">@GetSortByLabel(sortBy)</option>
                        }
                    }
                </select>
            </div>

            <div class="col-12 col-md-3">
                <label class="form-label" for="sortOrder">Порядок</label>
                <select id="sortOrder" name="SortOrder" class="form-select">
                    @foreach (SortOrder sortOrder in Enum.GetValues<SortOrder>())
                    {
                        if (Model.Query.SortOrder == sortOrder)
                        {
                            <option value="@sortOrder" selected>@GetSortOrderLabel(sortOrder)</option>
                        }
                        else
                        {
                            <option value="@sortOrder">@GetSortOrderLabel(sortOrder)</option>
                        }
                    }
                </select>
            </div>

            <div class="col-12 col-md-3">
                <label class="form-label" for="pageSize">Покупок на сторінці</label>
                <select id="pageSize" name="PageSize" class="form-select">
                    @foreach (int size in new[] { 5, 10, 20, 50, 100 })
                    {
                        if (Model.Query.PageSize == size)
                        {
                            <option value="@size" selected>@size</option>
                        }
                        else
                        {
                            <option value="@size">@size</option>
                        }
                    }
                </select>
            </div>

            <input type="hidden" name="Page" value="1" />

            <div class="col-12 col-md-3 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search"></i>
                    Застосувати
                </button>

                <a asp-controller="Purchases" asp-action="Index" class="btn btn-outline-secondary">
                    Скинути
                </a>
            </div>
        </form>
    </div>
</div>

@if (Model.IsEmpty)
{
    <div id="emptyPurchasesState" class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-receipt display-5 text-muted"></i>
            <h2 class="h5 mt-3">Покупок не знайдено</h2>
            <p class="text-muted mb-0">
                Збережіть поточний список продуктів як покупку, щоб побачити його тут.
            </p>
        </div>
    </div>
}
else
{
    <div id="purchasesList" class="d-flex flex-column gap-3">
        @foreach (var purchase in Model.Items)
        {
            string collapseId = $"receipt-{purchase.Id:N}";

            var visitedShops = purchase.Receipt
                .Select(entry => entry.Shop.ToLocalString())
                .Distinct()
                .OrderBy(shop => shop)
                .ToList();

            string visitedShopsText = visitedShops.Count > 0
                ? string.Join(", ", visitedShops)
                : "Магазини не вказані";

            <div class="card border-0 shadow-sm purchase-card" data-purchase-id="@purchase.Id">
                <div class="card-body">
                    <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">
                        <div>
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                <h2 class="h5 mb-0">
                                    Покупка від @purchase.Date.ToString("dd.MM.yyyy HH:mm")
                                </h2>

                                <span class="badge bg-primary text-white border border-primary">
                                    @FormatItemsCount(purchase.Receipt.Count)
                                </span>
                            </div>

                            <div class="text-muted small">
                                <i class="bi bi-shop me-1"></i>
                                @visitedShopsText
                            </div>
                        </div>

                        <div class="text-lg-end">
                            <div class="text-muted small">Загальна сума</div>
                            <div class="h4 mb-0">
                                @FormatMoney(purchase.Total) грн
                            </div>
                        </div>
                    </div>

                    <div class="d-flex flex-column flex-sm-row gap-2 mt-3">
                        <button class="btn btn-sm btn-outline-primary toggle-receipt-btn" type="button"
                                data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false"
                                aria-controls="@collapseId">
                            <i class="bi bi-list-ul"></i>
                            Показати чек
                        </button>

                        <button class="btn btn-sm btn-outline-danger remove-purchase-btn" type="button">
                            <i class="bi bi-trash"></i>
                            Видалити покупку
                        </button>
                    </div>

                    <div class="collapse receipt-collapse mt-3" id="@collapseId">
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0" style="table-layout: fixed; width: 100%;">
                                <colgroup>
                                    <col style="width: 40%;" />
                                    <col style="width: 22%;" />
                                    <col style="width: 20%;" />
                                    <col style="width: 18%;" />
                                </colgroup>

                                <thead class="table-light">
                                    <tr>
                                        <th>Продукт</th>
                                        <th>Магазин</th>
                                        <th>Кількість</th>
                                        <th class="text-end">Витрачено</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var entry in purchase.Receipt)
                                    {
                                        <tr>
                                            <td class="fw-semibold text-wrap">
                                                @entry.ProductName
                                            </td>

                                            <td class="text-wrap">
                                                <span class="badge bg-light text-dark border">
                                                    @entry.Shop.ToLocalString()
                                                </span>
                                            </td>

                                            <td class="text-nowrap">
                                                @entry.Measure.Count.ToString("0.###")
                                                @entry.Measure.Unit.ToLocalString()
                                            </td>

                                            <td class="text-end text-nowrap">
                                                @FormatMoney(entry.SpentAmount) грн
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4" aria-label="Пагінація покупок">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-controller="Purchases" asp-action="Index"
                           asp-route-DateFrom="@Model.Query.DateFrom" asp-route-DateTo="@Model.Query.DateTo"
                           asp-route-MinTotal="@Model.Query.MinTotal" asp-route-MaxTotal="@Model.Query.MaxTotal"
                           asp-route-SortBy="@Model.Query.SortBy" asp-route-SortOrder="@Model.Query.SortOrder"
                           asp-route-PageSize="@Model.Query.PageSize" asp-route-Page="@previousPage">
                        Попередня
                    </a>
                </li>

                @if (Model.TotalPages <= 5)
                {
                    @for (int pageNum = 1; pageNum <= Model.TotalPages; pageNum++)
                    {
                        <li class="page-item @(pageNum == currentPage ? "active" : "")">
                            <a class="page-link" asp-controller="Purchases" asp-action="Index"
                                   asp-route-DateFrom="@Model.Query.DateFrom" asp-route-DateTo="@Model.Query.DateTo"
                                   asp-route-MinTotal="@Model.Query.MinTotal" asp-route-MaxTotal="@Model.Query.MaxTotal"
                                   asp-route-SortBy="@Model.Query.SortBy" asp-route-SortOrder="@Model.Query.SortOrder"
                                   asp-route-PageSize="@Model.Query.PageSize" asp-route-Page="@pageNum">
                                @pageNum
                            </a>
                        </li>
                    }
                }
                else
                {
                    @for (int pageNum = 1; pageNum <= 4; pageNum++)
                    {
                        <li class="page-item @(pageNum == currentPage ? "active" : "")">
                            <a class="page-link" asp-controller="Purchases" asp-action="Index"
                                   asp-route-DateFrom="@Model.Query.DateFrom" asp-route-DateTo="@Model.Query.DateTo"
                                   asp-route-MinTotal="@Model.Query.MinTotal" asp-route-MaxTotal="@Model.Query.MaxTotal"
                                   asp-route-SortBy="@Model.Query.SortBy" asp-route-SortOrder="@Model.Query.SortOrder"
                                   asp-route-PageSize="@Model.Query.PageSize" asp-route-Page="@pageNum">
                                @pageNum
                            </a>
                        </li>
                    }

                    <li class="page-item disabled">
                        <span class="page-link">...</span>
                    </li>

                    <li class="page-item @(Model.TotalPages == currentPage ? "active" : "")">
                        <a class="page-link" asp-controller="Purchases" asp-action="Index"
                               asp-route-DateFrom="@Model.Query.DateFrom" asp-route-DateTo="@Model.Query.DateTo"
                               asp-route-MinTotal="@Model.Query.MinTotal" asp-route-MaxTotal="@Model.Query.MaxTotal"
                               asp-route-SortBy="@Model.Query.SortBy" asp-route-SortOrder="@Model.Query.SortOrder"
                               asp-route-PageSize="@Model.Query.PageSize" asp-route-Page="@Model.TotalPages">
                            @Model.TotalPages
                        </a>
                    </li>
                }

                <li class="page-item @(currentPage >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-controller="Purchases" asp-action="Index"
                           asp-route-DateFrom="@Model.Query.DateFrom" asp-route-DateTo="@Model.Query.DateTo"
                           asp-route-MinTotal="@Model.Query.MinTotal" asp-route-MaxTotal="@Model.Query.MaxTotal"
                           asp-route-SortBy="@Model.Query.SortBy" asp-route-SortOrder="@Model.Query.SortOrder"
                           asp-route-PageSize="@Model.Query.PageSize" asp-route-Page="@nextPage">
                        Наступна
                    </a>
                </li>
            </ul>
        </nav>
    }
}

@section Scripts {
    <script src="~/js/purchases.js" asp-append-version="true"></script>
}